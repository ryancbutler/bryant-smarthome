# Copy to .env, replace these placeholders, then run:
# python -m bryant_smarthome homes
# The first login stores a refresh token in your OS credential store; later commands reuse it.
# Optional: python -m bryant_smarthome login (verify credentials and save a session).
# Real environment variables override this file; --username overrides both.
BRYANT_USERNAME="your-email@example.com"
BRYANT_PASSWORD="replace-with-your-password"

# Values are literal: $ and ${...} are not expanded.
# Quote passwords containing spaces or #. Do not commit the real .env file.
